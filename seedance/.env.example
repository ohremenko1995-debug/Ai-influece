# ---------------------------------------------------------------------------
# seedance-gateway
#
# Credentials keep the names the providers themselves document, so an existing
# key in your shell works unchanged. Everything else is prefixed SEEDANCE_.
# ---------------------------------------------------------------------------

# --- BytePlus ModelArk (direct, international) -----------------------------
# The cheapest non-promo route and the only one that reports the tokens you were
# actually charged. Check the region host against your console.
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# --- Replicate -------------------------------------------------------------
# Same rate as direct at 480p/720p without a BytePlus account.
REPLICATE_API_TOKEN=

# --- WaveSpeed (standard and Turbo) ----------------------------------------
# Turbo is the cheapest published 720p rate — a different model, not a discount.
WAVESPEED_API_KEY=

# --- Pipeline --------------------------------------------------------------
# Drafts run cheap and finals run at delivery resolution. 480p -> 720p is 2.25x
# for the same footage, so every discarded take at 480p is where the saving is.
SEEDANCE_DRAFT_PROVIDER=modelark
SEEDANCE_DRAFT_RESOLUTION=480p
SEEDANCE_FINAL_PROVIDER=modelark
SEEDANCE_FINAL_RESOLUTION=720p

# --- Runner ----------------------------------------------------------------
# No provider publishes a concurrency ceiling, and one job holds a GPU for
# minutes. Start conservative and raise it once 429s show you the wall.
SEEDANCE_CONCURRENCY=8
SEEDANCE_POLL_INTERVAL_S=5
SEEDANCE_JOB_TIMEOUT_S=900
SEEDANCE_MAX_RETRIES=4

# --- Spend caps ------------------------------------------------------------
# 0 means no cap. A cap set with `seedance budget` is stored in the ledger and
# overrides these. Over the line, the submission does not go out.
SEEDANCE_DAILY_BUDGET_USD=0
SEEDANCE_MONTHLY_BUDGET_USD=0

# --- Storage ---------------------------------------------------------------
SEEDANCE_OUTPUT_DIR=./out
SEEDANCE_DB_PATH=./seedance.db
