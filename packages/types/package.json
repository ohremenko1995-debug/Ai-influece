{
  "name": "@influenceros/types",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the API's OpenAPI document",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/openapi.json --output ./src/generated/api.ts --root-types",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
