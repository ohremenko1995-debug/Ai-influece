{
  "name": "influenceros",
  "version": "0.1.0",
  "private": true,
  "description": "InfluencerOS — internal control center for AI influencer production",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @influenceros/web dev",
    "build": "pnpm --filter @influenceros/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @influenceros/web e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\""
  },
  "devDependencies": {
    "playwright-core": "1.57.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14"
  },
  "pnpm": {
    "//": "pnpm 10 blocks postinstall scripts by default. These two ship native binaries the toolchain needs (vitest's bundler and eslint's resolver), so they are explicitly allowed.",
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
