# ---------------------------------------------------------------------------
# InfluencerOS — local development environment template
#
# Copy to `.env` and adjust. This file MUST NOT contain real secrets.
# Every value below is a throwaway local-development placeholder.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console                       # console | json

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:3000

# Signing key for local JWTs ONLY. Generate a real one per environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In staging/production this must come from the secret manager, never from a file.
SECRET_KEY=dev-only-insecure-placeholder-change-me-before-any-real-use
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=10080

# Development authentication stub (`POST /api/v1/auth/dev-login`).
# Hard-refuses to activate unless ENVIRONMENT=development.
DEV_AUTH_ENABLED=true

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=influenceros
POSTGRES_PASSWORD=influenceros
POSTGRES_DB=influenceros
POSTGRES_TEST_DB=influenceros_test

# --- Redis (queue + cache) ---------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Object storage (MinIO locally, any S3-compatible endpoint in prod) ------
S3_ENDPOINT_URL=http://minio:9000
# Browser-reachable endpoint used when signing URLs handed to the frontend.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=influenceros-assets
S3_ACCESS_KEY_ID=influenceros
S3_SECRET_ACCESS_KEY=influenceros
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# --- Generation providers ----------------------------------------------------
# fake     -> FakeGenerationProvider (deterministic, local dev + tests)
# comfyui  -> ComfyUIProvider (requires a reachable ComfyUI instance)
GENERATION_PROVIDER=fake
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_TIMEOUT_SECONDS=30
COMFYUI_MAX_RETRIES=3

# --- Frontend ----------------------------------------------------------------
# Consumed by the browser bundle; must be reachable from the user's machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
